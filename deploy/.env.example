# Copy to .env (next to docker-compose.yml) and fill in.

# Your domain, pointed at this server. Caddy gets the HTTPS certificate.
DOMAIN=torza.example.com
PUBLIC_URL=https://torza.example.com

# Secret for signing download links. Generate with: openssl rand -hex 32
SIGNING_KEY=

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# qBittorrent Web UI login. See README "First start" for setting it.
QBIT_USER=admin
QBIT_PASS=

# Where downloads and the cache live on the server.
DATA_PATH=./data

# Cost controls (see ARCHITECTURE.md).
MAX_ACTIVE_PER_USER=3
MAX_TORRENT_BYTES=100GB
CACHE_MAX_BYTES=0
CACHE_MIN_FREE_BYTES=20GB
LINK_TTL=6h
