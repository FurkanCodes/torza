# Settings for the local run. ./local.sh creates .env.local from this file and
# fills in the secrets the first time it runs.

# Caddy is off locally, but the shared compose file still needs a value.
DOMAIN=localhost
# Download links point here. Players on this Mac can open them directly.
PUBLIC_URL=http://localhost:8081

SIGNING_KEY=
POSTGRES_PASSWORD=
QBIT_USER=admin
QBIT_PASS=

# Downloads and the cache, inside deploy/ (ignored by git).
DATA_PATH=./data-local

# Keep the cache small on a laptop.
MAX_ACTIVE_PER_USER=3
MAX_TORRENT_BYTES=20GB
CACHE_MAX_BYTES=30GB
CACHE_MIN_FREE_BYTES=20GB
LINK_TTL=6h
